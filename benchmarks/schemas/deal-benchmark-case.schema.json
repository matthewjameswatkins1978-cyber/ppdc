{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deal-benchmark-case.schema.json",
  "title": "PayPal Deal Checker benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "locale", "scenario_class", "modalities", "input", "expected", "hard_failures", "source_ids"],
  "properties": {
    "id": { "type": "string", "pattern": "^(CORE-(0[1-9]|1[0-9]|2[0-4])|ADV-0[1-8])$" },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "scenario_class": { "type": "string", "minLength": 1 },
    "modalities": { "type": "array", "items": { "enum": ["text", "image", "web", "tool", "human"] }, "minItems": 1, "uniqueItems": true },
    "input": {
      "type": "object", "required": ["deal_text", "evidence", "context"], "additionalProperties": false,
      "properties": {
        "deal_text": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "context": { "type": "object" },
        "recorded_research": { "type": "array", "items": { "type": "object" } },
        "private_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expected": {
      "type": "object", "required": ["facts", "unknowns", "findings", "follow_up", "research", "conclusion"], "additionalProperties": false,
      "properties": {
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "follow_up": { "type": "object", "required": ["needed", "questions"], "properties": { "needed": { "type": "boolean" }, "questions": { "type": "array", "items": { "type": "string" } } } },
        "research": { "type": "object", "required": ["required", "provider", "query_should_contain", "query_must_not_contain"], "properties": { "required": { "type": "boolean" }, "provider": { "enum": ["channel3", "parallel", "either", "none"] }, "query_should_contain": { "type": "array", "items": { "type": "string" } }, "query_must_not_contain": { "type": "array", "items": { "type": "string" } } } },
        "conclusion": { "type": "object", "required": ["must_include_concepts", "must_not_include_concepts", "recommended_action_class", "certainty_ceiling"], "properties": { "must_include_concepts": { "type": "array", "items": { "type": "string" } }, "must_not_include_concepts": { "type": "array", "items": { "type": "string" } }, "recommended_action_class": { "type": "string" }, "certainty_ceiling": { "enum": ["bounded", "low", "not_applicable"] } } }
      }
    },
    "hard_failures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "evidence": { "type": "object", "required": ["id", "kind", "text", "private"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "text": { "type": "string" }, "private": { "type": "boolean" } } },
    "fact": { "type": "object", "required": ["key", "value", "kind", "evidence_id", "required"], "properties": { "key": { "type": "string" }, "value": {}, "kind": { "enum": ["fact", "paypal_rule", "inference", "unknown"] }, "evidence_id": { "type": ["string", "null"] }, "required": { "type": "boolean" } } },
    "finding": { "type": "object", "required": ["category", "required", "expected_severity", "allowed_severities", "must_reference_rule", "must_include_concepts", "must_not_include_concepts"], "properties": { "category": { "type": "string" }, "required": { "type": "boolean" }, "expected_severity": { "enum": ["green", "amber", "red"] }, "allowed_severities": { "type": "array", "items": { "enum": ["green", "amber", "red"] }, "minItems": 1, "uniqueItems": true }, "must_reference_rule": { "type": ["string", "null"] }, "must_include_concepts": { "type": "array", "items": { "type": "string" } }, "must_not_include_concepts": { "type": "array", "items": { "type": "string" } } } }
  }
}
