{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "ppdc-ai-analysis/1"
    },
    "cases": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "candidate_facts": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "attribution": {
                  "type": "string",
                  "enum": [
                    "seller_claim",
                    "buyer_statement",
                    "document_text",
                    "observed_text",
                    "unknown"
                  ]
                },
                "evidence": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "source_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "field",
                "value",
                "attribution",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "seller_claims": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "attribution": {
                  "type": "string",
                  "enum": [
                    "seller_claim",
                    "buyer_statement",
                    "document_text",
                    "observed_text",
                    "unknown"
                  ]
                },
                "evidence": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "source_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "field",
                "value",
                "attribution",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "unknowns": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "evidence": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "source_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "field",
                "text",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "contradictions": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "candidates": {
                  "minItems": 2,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 500
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "currency": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "attribution": {
                        "type": "string",
                        "enum": [
                          "seller_claim",
                          "buyer_statement",
                          "document_text",
                          "observed_text",
                          "unknown"
                        ]
                      },
                      "evidence": {
                        "minItems": 1,
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            }
                          },
                          "required": [
                            "source_id",
                            "quote"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "value",
                      "attribution",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                },
                "resolution": {
                  "type": "null"
                }
              },
              "required": [
                "field",
                "candidates",
                "resolution"
              ],
              "additionalProperties": false
            }
          },
          "buyer_questions": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "abstentions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "evidence": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "source_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "field",
                "text",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "case_id",
          "candidate_facts",
          "seller_claims",
          "unknowns",
          "contradictions",
          "buyer_questions",
          "abstentions",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "cases"
  ],
  "additionalProperties": false
}