# Local environment only; never commit credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
CHANNEL3_API_KEY=replace-with-channel3-api-key
PARALLEL_API_KEY=replace-with-parallel-api-key
PPDC_DEAL_MODEL_PROVIDER=rules
GEMINI_API_KEY=replace-with-google-ai-studio-key
PPDC_GEMINI_MODEL=gemini-3.1-flash-lite
PPDC_PUBLIC_ORIGIN=http://localhost:3000
# Optional private Astropods bridge; remains disabled unless explicitly enabled.
PPDC_ASTROPODS_ENABLED=false
PPDC_ASTROPODS_MODE=hosted
PPDC_ASTROPODS_BASE_URL=https://astropods.com
PPDC_ASTROPODS_MODEL=gpt-5-6-luna
# Hosted mode is reserved for a separate private deployment review.
PPDC_ASTROPODS_DEPLOYMENT_ID=replace-with-private-deployment-id
PPDC_ASTROPODS_BEARER_TOKEN=replace-with-server-only-token
